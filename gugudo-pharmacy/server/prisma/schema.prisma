generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  phone     String?
  password  String
  role      Role       @default(CUSTOMER)
  language  String     @default("en")
  theme     String     @default("light")
  blocked   Boolean    @default(false)
  createdAt DateTime   @default(now())
  addresses Address[]
  orders    Order[]
  messages  Message[]
  audits    AuditLog[]
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  text      String
  phone     String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id           Int         @id @default(autoincrement())
  name         String
  generic      String?
  description  String?
  price        Float
  stock        Int         @default(0)
  lowStockAt   Int         @default(10)
  requiresRx   Boolean     @default(false)
  imageUrl     String?
  batchNo      String?
  expiry       DateTime?
  manufacturer String?
  active       Boolean     @default(true)
  categoryId   Int?
  category     Category?   @relation(fields: [categoryId], references: [id])
  items        OrderItem[]
  createdAt    DateTime    @default(now())
}

model Order {
  id              Int           @id @default(autoincrement())
  code            String        @unique
  customerId      Int
  customer        User          @relation(fields: [customerId], references: [id])
  status          OrderStatus   @default(PENDING)
  paymentMethod   String        @default("COD")
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Float
  deliveryFee     Float
  total           Float
  addressText     String
  phone           String
  lat             Float?
  lng             Float?
  notes           String?
  prescriptionUrl String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Float
  qty       Int
}

model Message {
  id          Int      @id @default(autoincrement())
  customerId  Int
  customer    User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromStaff   Boolean  @default(false)
  body        String
  readByStaff Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())
}
